{
  "name": "overseer",
  "version": "0.1.0",
  "private": true,
  "description": "The Overseer — the K-record accountability layer for agent calls. Outcome 1: wrapper, record store, Muse Spark call path.",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.9.0"
  },
  "scripts": {
    "prove": "node --env-file-if-exists=.env bin/overseer.js prove",
    "prove:dry": "node --env-file-if-exists=.env bin/overseer.js prove --dry-run",
    "prove:baseten": "node --env-file-if-exists=.env bin/overseer.js prove --plug baseten",
    "prove:openrouter": "node --env-file-if-exists=.env bin/overseer.js prove --plug openrouter",
    "task": "node --env-file-if-exists=.env bin/overseer.js task",
    "folders": "node --env-file-if-exists=.env bin/overseer.js folders",
    "judge": "node --env-file-if-exists=.env bin/overseer.js judge",
    "panel": "node --env-file-if-exists=.env bin/overseer.js panel",
    "records": "node --env-file-if-exists=.env bin/overseer.js records",
    "page": "node --env-file-if-exists=.env bin/overseer.js page",
    "live": "node --env-file-if-exists=.env bin/overseer.js live",
    "picture": "node --env-file-if-exists=.env bin/overseer.js picture",
    "status": "node --env-file-if-exists=.env bin/overseer.js status",
    "test": "node --test"
  }
}
