# Copy this file to .env and fill in the key. .env is ignored by git.
# Get a key from the Model API dashboard (see https://dev.meta.ai/docs/api-reference).

# Required for "npm run prove".
MODEL_API_KEY=

# Optional. The documented default is used when this is unset.
# MODEL_ID=muse-spark-1.3

# Optional. Where records are written. Default: records/k-record.jsonl
# OVERSEER_RECORDS=records/k-record.jsonl
