[TEMPLATE]
# Copy this file to .env and fill in what you need. .env is ignored by git.

# --- meta: the Worker agent's path ------------------------------------------
# Required for "npm run prove". Get one from the Model API dashboard.
MODEL_API_KEY=

# Optional. Meta's documented default is used when this is unset.
# MODEL_ID=muse-spark-1.3

# --- baseten: the Overseer agent's path -------------------------------------
# Both are needed before a Baseten call can be made. No model is set here on
# purpose: BASETEN_MODEL is the model Darren picks.
# BASETEN_API_KEY=
# BASETEN_MODEL=

# --- openrouter: interim development path -----------------------------------
# No address and no model are baked into the code; both are read from here.
# OPENROUTER_BASE_URL=
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=

# --- picture: the picture kid's slot ----------------------------------------
# Deliberately empty. The open-weights provider and the model are Darren's pick.
# PICTURE_BASE_URL=
# PICTURE_API_KEY=
# PICTURE_MODEL=

# Optional. Where records are written. Default: records/k-record.jsonl
# OVERSEER_RECORDS=records/k-record.jsonl
