[TEMPLATE]
# Copy this file to .env and fill in what you need. .env is ignored by git.

# --- meta: the Worker agent's path ------------------------------------------
# Required for "npm run prove". Get one from the Model API dashboard.
MODEL_API_KEY=

# Optional. Meta's documented default is used when this is unset.
# MODEL_ID=muse-spark-1.3

# --- baseten: the Overseer agent's path -------------------------------------
# Both are needed before a Baseten call can be made. Baseten's mandated
# hackathon model is meta-models/muse-spark-open-1026. Skipped for the
# 29 Oct 2026 submission wrap: the plug is blocked on the key only.
# BASETEN_API_KEY=
# BASETEN_MODEL=meta-models/muse-spark-open-1026

# --- openrouter: interim development path -----------------------------------
# No address and no model are baked into the code; both are read from here.
# OPENROUTER_BASE_URL=
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=

# --- the judge panel: three seats, and the bank behind them ------------------
# Seat 1 is the main seat: Muse, through the meta plug above. No model variable
# of its own — it uses the plug's documented default.
#
# Seats 2 and 3 are the provisional free seats, served by the nvidia plug. The two
# models below are the best reasoning models NVIDIA serves, and they are named here
# rather than in code so seat 2 and seat 3 are a decision you can see. Both were
# checked against the live endpoint on 2026-10-27: the address accepts each ID and
# answers, and NVIDIA's own catalog lists both as reasoners on a free endpoint.
#
# Seat 2 is NVIDIA's own flagship reasoner: a hybrid Mamba-Transformer MoE with a
# 1M context, which its catalog card describes as "excelling in agentic reasoning,
# coding, planning, tool calling".
PANEL_SEAT2_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# Seat 3 is OpenAI's open-weights model, for a third lab's reading. It was chosen
# because it answers inside the seam's 60 s timeout: on 2026-10-27 it answered a
# one-line task in 3.9 s, where z-ai/glm-5.3-flash timed out at 60 s on the same
# task. Three other candidates also timed out, so a model is only seated after it
# has answered here.
PANEL_SEAT3_MODEL=openai/gpt-oss-20b
#
# A key for the free seats' provider. Get one from https://build.nvidia.com/models
# The trial is free to prototype with, rate-limited rather than billed.
# NVIDIA_API_KEY=
# The model the nvidia plug offers when it fills a seat in the bank. A third lab
# again, and a fast one, because a fill happens after a call has already failed.
NVIDIA_MODEL=google/gemma-4-31b-it
#
# Ranking, if you want to move them (all free, all checked callable):
#   nvidia/nemotron-3-ultra-550b-a55b      the strongest stated reasoner
#   z-ai/glm-5.3-flash                     reasoning, fast
#   google/gemma-4-31b-it                  "frontier reasoning", dense 31B
#   nvidia/nemotron-3.5-super-vl-120b-a12b NVIDIA's newest, early access
#   deepseek-ai/deepseek-v4.1-flash        552B MoE / 8B active, cheapest
#   moonshotai/kimi-k2.6                   a fourth lab; no catalog card found
#   stepfun-ai/step-5-preview              600B / 27B, preview
#   openai/gpt-oss-20b                     small, cheapest of all
# Do not seat a second judge on meta/muse-glimmer-30b: it is Muse's own family,
# and seat 1 is already Muse, so the panel would be one mind answering twice.
# Gone from the catalog, so these refuse rather than answer: qwen/qwen3-235b-a22b
# and deepseek-ai/deepseek-r1 (not served), moonshotai/kimi-k2-thinking,
# openai/gpt-oss-120b and nvidia/llama-3.3-nemotron-super-49b-v1.5 (retired).
#
# Which plug serves which seat, if you move one: PANEL_SEAT1_PLUG, PANEL_SEAT2_PLUG,
# PANEL_SEAT3_PLUG. The plugs are meta, openrouter, baseten, nvidia, picture.
#
# The bank: which plugs fill a seat whose own judge failed, in order. Free first by
# default so failover does not add spend by surprise. An empty value means no bank.
# PANEL_BANK=nvidia,openrouter

# --- picture: the picture kid ----------------------------------------------
# Wired 2026-10-30 to Muse Image on the Meta Model API (Darren's pick).
# No second key: Muse Image uses the same base and key as the Worker above
# (MODEL_API_KEY). Overrides only, if you ever move it:
# PICTURE_BASE_URL=https://api.meta.ai/v1
# PICTURE_MODEL=muse-image-1.0
# Live prove: npm run picture -- --prompt "..."  (saves a file, writes nothing to the record)
# Note: Muse Image is proprietary, not open weights — a Meta-tooling leg,
# not the open-weights bonus leg. Muse Spark / Spark Open / Glimmer cannot
# fill this slot: they are text-out only and cannot draw.

# Optional. Where records are written. Default: records/k-record.jsonl
# OVERSEER_RECORDS=records/k-record.jsonl
